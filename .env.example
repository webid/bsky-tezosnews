# Bluesky credentials (required)
BSKY_HANDLE=tezosnews.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Feed source
FEED_URL=https://tezlens.purplematter.com/api/articles
# MEC_EVENTS_URL=http://thetezos.com/wp-json/wp/v2/mec-events

# Delay between posts when catching up (milliseconds, default: 5 minutes)
CATCHUP_INTERVAL_MS=300000

# How often to check for new articles in daemon mode (milliseconds, default: 30 minutes)
CHECK_INTERVAL_MS=1800000

# SQLite database path
DB_PATH=./data/posted.db

# Set to "true" to log posts without actually sending them
DRY_RUN=false
